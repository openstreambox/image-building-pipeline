# Root on microSD, mounted by the kernel using the GPT PARTUUID.
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_SERIAL_8250_DW=y

# USB-C 1 uses the DWC3 peripheral and Innosilicon USB2 PHY. The other
# controller stays in host mode for downstream devices.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_SND=m

# Direct-kernel boot on QEMU virt uses the same ext4 root filesystem.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y

# This image has a wired head link.
# CONFIG_WLAN is not set
# CONFIG_BT is not set
CONFIG_DEBUG_INFO_NONE=y
