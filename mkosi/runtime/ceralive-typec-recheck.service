[Unit]
Description=CeraLive Rock USB-C back-power recheck
ConditionFirmware=device-tree-compatible(radxa,rock-5b-plus)
# The timer's first tick (OnBootSec=8s) lands when the boot run of the policy
# usually starts. Both take the same Rock lock, and a recheck that wins it may
# spend the whole settle deadline on a blind port_type cycle while the boot run,
# ordered Before=cerastream/ceralive, waits behind it and holds both back.
# Ordering only: a pending boot run finishes first (it never cycles without a
# partner), and once it is done this edge has no effect on later ticks.
After=ceralive-typec-policy.service

[Service]
Type=oneshot
Environment=CERALIVE_TYPEC_MODE=recheck
ExecStart=/usr/local/sbin/ceralive-typec-policy
TimeoutStartSec=60
# Six starts a minute would otherwise journal three systemd info lines each
# (about 1,100 entries an hour) while nothing changes. The policy script logs
# its decisions at notice or above, so they still reach the journal, and any
# untagged line (a shell or kernel error on stderr) defaults to notice too.
LogLevelMax=notice
SyslogLevel=notice
