// Deliberate power-off/reboot override from a terminal: `systemctl poweroff -i`,
// `systemctl reboot -i` (and --check-inhibitors=no), typed by an administrator.
//
// While CeraUI streams it holds a logind `block` lock. On systemd 257 logind
// refuses every plain power request under such a lock, root included, and for
// `-i` it always asks polkit; polkit then gives root no implicit pass. Plain
// `poweroff`/`reboot` keep refusing during a stream; this rule only answers
// the explicit override.
//
// Granted only when all of these hold, and never otherwise:
//  - the caller is root or a member of `sudo` (the `ceralive` login user);
//  - it runs in an interactive login: a logind session scope (OpenSSH,
//    console), the OpenSSH service itself, or a Tailscale SSH shell, which
//    tailscaled starts inside tailscaled.service without a logind session;
//  - the calling process has a controlling terminal, so a script run over
//    `ssh box cmd` without a terminal, a timer or a daemon cannot use it.
// CeraUI (ceralive.service), the web front, other services and user services
// fail the unit check; an unknown unit or an unreadable process is refused.
// For a member of `sudo` the same scope also covers the plain power actions,
// which otherwise ask for a password a remote session cannot give.
var ceraliveTerminalUnit = /^(session-[A-Za-z0-9]+\.scope|ssh\.service|tailscaled\.service)$/;
var ceralivePowerActions = [
    "org.freedesktop.login1.power-off-ignore-inhibit",
    "org.freedesktop.login1.reboot-ignore-inhibit",
    "org.freedesktop.login1.halt-ignore-inhibit",
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.halt",
    "org.freedesktop.login1.power-off-multiple-sessions",
    "org.freedesktop.login1.reboot-multiple-sessions",
    "org.freedesktop.login1.halt-multiple-sessions"
];

function ceraliveHasTerminal(pid) {
    try {
        var stat = polkit.spawn(["/usr/bin/cat", "/proc/" + pid + "/stat"]);
        // Fields after the command name: state ppid pgrp session tty_nr ...
        var fields = stat.substring(stat.lastIndexOf(")") + 2).split(" ");
        return parseInt(fields[4], 10) > 0;
    } catch (error) {
        return false;
    }
}

polkit.addRule(function(action, subject) {
    if (ceralivePowerActions.indexOf(action.id) < 0)
        return polkit.Result.NOT_HANDLED;
    if (subject.user != "root" && !subject.isInGroup("sudo"))
        return polkit.Result.NOT_HANDLED;
    if (!subject.system_unit || !ceraliveTerminalUnit.test(subject.system_unit))
        return polkit.Result.NOT_HANDLED;
    if (!ceraliveHasTerminal(subject.pid))
        return polkit.Result.NOT_HANDLED;
    return polkit.Result.YES;
});
