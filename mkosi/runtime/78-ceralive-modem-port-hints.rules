# 78-ceralive-modem-port-hints.rules: AT ports ModemManager leaves alone.
#
# Installed by mkosi/customize/postinst.d/networking.sh::setup_modem_port_hints
# into /etc/udev/rules.d. The basename is image-owned and shared with no packaged
# rules file (manifests/modem-support-ownership.txt).
#
# Only ENV properties are set, and only on ttys of an exact USB vendor/product
# pair and interface number. ID_MM_PORT_IGNORE=1 makes ModemManager list the port
# as "(ignored)" and never open or probe it; ModemManager's own
# 77-mm-*-port-types.rules hints stay in place for every other interface. The
# interface number is captured the way ModemManager's rules do it, into a private
# (dot) property. A change takes effect for a modem probed afterwards (boot,
# replug, or a re-probe of that modem).

ACTION!="add|change|move|bind", GOTO="ceralive_mm_port_hints_end"
SUBSYSTEM!="tty", GOTO="ceralive_mm_port_hints_end"
SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.CERALIVE_MM_USBIFNUM}="$attr{bInterfaceNumber}"

# Dell DW5821e (413c:81d7, recorded MBIM composition, configuration 2; other
# compositions are outside that evidence): interfaces 2 and 3 are its AT
# ports. Data, SIM, registration and carrier configuration all run over MBIM
# (with QMI over MBIM), and ModemManager creates an MBIM modem without an AT
# port. While these ports are probed, the Dell plugin's custom init sends AT+GMI
# until the module answers (three tries, 3 s timeout each); that runs beside the
# MBIM probe and decides when the modem appears whenever it finishes last.
# Ignoring both ports takes AT probing off that path. What is lost: unmanaged GPS
# (it needs a ModemManager AT port) and the "(at)" entry in ModemManager's port
# list that CeraUI's USB-mode dialog looks for.
ATTRS{idVendor}=="413c", ATTRS{idProduct}=="81d7", ENV{.CERALIVE_MM_USBIFNUM}=="02", ENV{ID_MM_PORT_IGNORE}="1"
ATTRS{idVendor}=="413c", ATTRS{idProduct}=="81d7", ENV{.CERALIVE_MM_USBIFNUM}=="03", ENV{ID_MM_PORT_IGNORE}="1"

# Quectel RM520N-GL / RM530N-GL (2c7c:0801, QMI configuration): interface 3 is
# ModemManager's secondary AT port (0 QCDM, 1 GPS, 2 AT primary, 3 AT secondary).
# ModemManager keeps the primary AT, QMI and data ports. CeraUI reads the module
# temperature (AT+QTEMP) and the serving cell (AT+QENG="servingcell") read-only on
# this port, and only when the udev database says it was released here. Without
# this rule CeraUI refuses both reads: "owned-by-modemmanager" while ModemManager
# lists the tty as an AT port, otherwise "not-released".
# Scope: the match uses the USB ID and interface number only, not the USB
# configuration or the retail model. 2c7c:0801 is shared by the RM520N-GL and the
# RM530N-GL; the layout above is the recorded QMI composition (configuration 1).
# Other compositions of this ID, such as MBIM, are outside that evidence.
ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0801", ENV{.CERALIVE_MM_USBIFNUM}=="03", ENV{ID_MM_PORT_IGNORE}="1"

LABEL="ceralive_mm_port_hints_end"
