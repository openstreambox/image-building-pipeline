[Unit]
Description=CeraLive: start persistent calendar timers once chrony has set the clock
Documentation=man:systemd.timer(5) man:chronyc(1)
# WHY THIS EXISTS (Rock 5B+ booted from an SD card, cold boots):
#
# The board's RTC (hym8563) has no battery, so after a power cut it holds no
# valid time and PID 1 starts the clock at /usr/lib/clock-epoch, the image
# build date. Every persistent calendar timer then logs
#   "Not using persistent file timestamp <last run> as it is in the future"
# and treats its job as overdue. chrony steps the clock about 20 s later, but
# a timer only reads its stamp when it starts, so the damage is done: each of
# these jobs ran on every boot. fstrim.service discarded about 51 GiB
# (all free space on /data, / and /boot) within the first 100 minutes of every
# boot, while streams were starting, instead of once a week.
#
# systemd's own guard is that calendar timers are ordered after
# time-sync.target, but nothing holds that target back on this image:
# chrony-wait.service is masked because it delayed multi-user.target by ~21 s
# (suppress_unusable_boot_units). Unmasking it, or ordering the timers behind a
# similar waiter, would leave a start job queued until the clock syncs, so
# `systemctl is-system-running` would read "starting" for that time, and for
# up to the waiter's timeout on a box without an uplink.
#
# Instead the timers carry ConditionPathExists=/run/ceralive/clock-synchronized
# (50-ceralive-clock-gate.conf), so they are skipped at boot, and this unit
# waits in the background for chrony to report a synchronised clock, writes
# that flag and starts every enabled timer that carries the drop-in. Each then
# reads its stamp against the real time and keeps its intended cadence. Until
# the clock syncs, these jobs do not run; with no real time there is no way to
# tell whether a week has passed.
After=chrony.service chronyd-restricted.service

[Service]
# exec, not oneshot: the unit is active as soon as the waiter runs, so nothing
# at boot waits for the clock.
Type=exec
ExecStart=/usr/libexec/ceralive/ceralive-clock-gate
# chronyc or the flag failing (exit 1) is retried; a timer that will not start
# (exit 2) is not.
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
