# The S99 device tree has a dedicated full-speed trip. Keep the open-drain
# PWM enabled at zero duty. Disabling the inverted Rockchip output also
# drives the fan input low, but leaves the controller disabled.
ACTION=="add", SUBSYSTEM=="hwmon", KERNELS=="pwm-fan", ATTR{name}=="pwmfan", TEST=="/sys/firmware/devicetree/base/thermal-zones/package-thermal/trips/case-fan-full", ATTR{pwm1_enable}="2"
