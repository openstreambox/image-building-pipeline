[Unit]
Description=Persist previous-boot reset evidence
DefaultDependencies=no
After=data.mount
After=local-fs.target systemd-udev-trigger.service sys-fs-pstore.mount
Before=systemd-pstore.service multi-user.target shutdown.target
Conflicts=shutdown.target
Wants=sys-fs-pstore.mount
ConditionPathIsMountPoint=/data

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ceralive-reset-evidence collect
RemainAfterExit=yes
UMask=0077
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
