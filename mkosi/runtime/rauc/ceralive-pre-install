#!/bin/sh
# RAUC pre-install handler: refuse to write any slot while a power-off or
# reboot is pending. RAUC runs this inside its install worker, after the bundle
# is mounted and before any slot is written, whoever started the install (the
# CLI, a direct D-Bus call, the hawkBit updater). The power broker (fence
# "broker", for an admitted request) and the shutdown drain (fence "shutdown")
# each create their own fence before their final writer check, so an install
# either became visible to that check (its bundle is mounted) or is refused
# here. Nothing has been written when it is refused; RAUC unmounts the bundle
# and the install can be retried once no fence is left.
FENCE_DIR="${CERALIVE_POWER_FENCE_DIR:-/run/ceralive-power/fence.d}"
for fence in "$FENCE_DIR"/*; do
  case "$fence" in *.new) continue ;; esac
  if [ -e "$fence" ]; then
    echo "ceralive: a power-off or reboot is pending ($(basename "$fence")); this install is refused before writing" >&2
    exit 1
  fi
done
exit 0
