#!/usr/sbin/nft -f
# Tailscale loopback allowlist (remote-access images).
#
# In userspace-networking mode tailscaled terminates tailnet connections itself
# and re-dials them to 127.0.0.1:<port> (or ::1). The box's other firewalls key
# on the ingress interface and accept loopback, so without this table every
# loopback service would be reachable from any tailnet peer the ACL allows:
# anonymous RTMP/SRT ingest on :1935/:4001, preview and helper ports, and so on.
#
# Packets that tailscaled's own cgroup sends to loopback may only reach:
#   tcp 18080   the CeraUI backend (static UI + password RPC; the LAN front door
#               on 80/443 binds to physical interfaces only, by design)
#   tcp/udp 53  the systemd-resolved stub, which tailscaled itself uses for DNS
# Everything else is refused. Tailscale SSH is served inside tailscaled and never
# dials loopback. Processes started from a Tailscale SSH session stay in this
# cgroup, so they get the same allowlist; use `systemd-run --pty` for loopback
# diagnostics from such a session.
#
# Loaded by tailscaled.service ExecStartPre, after systemd created the service's
# cgroup (`socket cgroupv2` resolves the path when the rule is loaded), and again
# on every restart. Self-replacing like the other ceralive tables.
table inet ceralive_tailscale_lo
delete table inet ceralive_tailscale_lo

table inet ceralive_tailscale_lo {
	chain output {
		type filter hook output priority 0; policy accept;
		oifname "lo" socket cgroupv2 level 2 "system.slice/tailscaled.service" jump from_tailscaled
	}
	chain from_tailscaled {
		tcp dport { 18080, 53 } accept
		udp dport 53 accept
		meta l4proto tcp counter reject with tcp reset
		counter reject
	}
}
