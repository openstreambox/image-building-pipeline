[Unit]
Description=Tailscale node agent (remote access, idle until enrolled)
Documentation=https://tailscale.com/docs/
# Enabled in the image but inert: it starts only once the box holds Tailscale
# state or a pending enrollment key, both on /data so they survive A/B updates.
# A box that is never enrolled never runs it.
ConditionPathExists=|/var/lib/tailscale/tailscaled.state
ConditionPathExists=|/var/lib/tailscale/pending-authkey
Wants=network-pre.target
After=network-pre.target NetworkManager.service ceralive-migrate-data.service
RequiresMountsFor=/var/lib/tailscale

[Service]
# Userspace networking: no tailscale0 interface, routes, policy rules or
# firewall rules, so CeraUI's uplink, bonding and default-route handling never
# see Tailscale. Tailscale SSH and connections to the box's own ports (web UI)
# still work through the userspace stack.
ExecStart=/usr/local/sbin/tailscaled --tun=userspace-networking --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=0
ExecStopPost=/usr/local/sbin/tailscaled --cleanup
Restart=on-failure
RestartSec=5
RuntimeDirectory=tailscale
RuntimeDirectoryMode=0755
CacheDirectory=tailscale
CacheDirectoryMode=0750
Type=notify

[Install]
WantedBy=multi-user.target
