[Unit]
Description=Enroll in Tailscale from a key file on the BOOT partition
# Runs when someone put an osb-tailscale*.key file (any case) on the card's BOOT
# drive (readable on any PC after flashing), when another local writer (CeraUI's
# Remote access card) dropped incoming-authkey, or when an earlier attempt left a
# pending key in the root-only /data/tailscale-enroll. ceralive-tailscale-enroll.timer
# re-runs it; the script backs off (2 to 30 minutes) and gives up after a final
# refusal or 100 failed keyed attempts (a key it cannot judge yet just waits).
ConditionPathExistsGlob=|/boot/[oO][sS][bB]-[tT][aA][iI][lL][sS][cC][aA][lL][eE]*
ConditionPathExists=|/data/tailscale-enroll/pending-authkey
ConditionPathExists=|/data/tailscale-enroll/incoming-authkey
# No network-online.target edge (first-party policy, runtime-services.bats): an
# attempt without a network fails like any DNS or timeout error and backs off.
After=local-fs.target ceralive-migrate-data.service NetworkManager.service
RequiresMountsFor=/boot /var/lib/tailscale /data/tailscale-enroll

[Service]
LogLevelMax=notice
SyslogLevel=notice
SyslogIdentifier=ceralive-tailscale-enroll
Type=oneshot
ExecStart=/usr/local/sbin/ceralive-tailscale-enroll
