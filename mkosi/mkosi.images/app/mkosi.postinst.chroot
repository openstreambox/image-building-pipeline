#!/usr/bin/env bash
#
# app/mkosi.postinst.chroot — APPLICATION layer (Stage 3): install first-party apps.
#
# Runs INSIDE the app tree (via mkosi-chroot) after the finished OS runtime tree is
# in place (app/mkosi.conf: BaseTrees=%O/runtime). The orchestrator stages the
# first-party .debs at FIRST_PARTY_DIR via an mkosi ExtraTree, with a source-tree
# staging fallback for app subimage builds. This script installs them into the
# rootfs, then drops the staging tree so it never ships.
#
# WHAT INSTALLS HERE (LAYER-MAP.md §Layer 4):
#   * libsrt1.5-ceralive — runtime ABI package, replacing Debian TLS flavors.
#   * cerastream / srtla — SYSEXT-class: pure /usr binaries.
#   * CeraUI (ceralive-device .deb)           — APPFS-class: a full-filesystem payload
#       (/usr/local/bin + /etc + /var/www) that CANNOT be a sysext — a sysext merges
#       only /usr+/opt, never /etc or /var. Its OTA delivery is the appfs backend
#       (mkosi/app/build-ceraui-appfs.sh). Moving CeraUI to sysext is a
#       CeraUI-REPO change, explicitly OUT OF SCOPE — docs/deferred-ceraui-sysext.md.
#
# IN-IMAGE install handles BOTH classes together: the BASE IMAGE bakes every
# first-party .deb into the rootfs (docs/partition-contract.md §4 "No appfs": app
# .debs live in the rootfs, atomic with the RAUC slot; a later sysext refresh merely
# shadows the baked-in binary). The sysext/appfs split is the OTA-delivery contract,
# NOT an in-image install difference — so it is reflected here only in classification
# + logging, while one local dpkg transaction installs all staged .debs.
# Runtime provides libgstreamer*. fetch-debs stages the CeraLive SRT runtime beside
# cerastream, so this transaction replaces Debian's TLS-flavor libsrt package without
# a network dependency.
#
# OFFLINE/DEV builds stage NO first-party .debs (fetch-debs dry-run) — this script
# then installs nothing and the image stays headless-clean (same graceful pattern as
# the runtime layer's setup_hawkbit_updater). The parity gate WARNs about the absent
# first-party packages in that mode, by design (non-vacuity / deferral pattern).
#
# STRICT: set -euo pipefail, NO `|| true` swallowing (common.sh DESIGN RULE). A
# staged-but-unsatisfiable .deb fails the build LOUDLY — never a half-image.

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

log() { printf '[app] %s\n' "$*" >&2; }
die() { printf '[app] FATAL: %s\n' "$*" >&2; exit 1; }

# Where the orchestrator drops the first-party .debs (mkosi ExtraTree).
FIRST_PARTY_DIR="/opt/ceralive-staging"

# First-party package classes, keyed by Debian Package: name. The DELIVERY backend
# differs per class (sysext .raw vs appfs payload) but the in-image install is
# apt-get for both — see header. rauc-hawkbit-updater is NOT a first-party app: it
# is the runtime layer's OTA backport (setup_hawkbit_updater), so it is skipped here
# if it happens to share the staging dir.
SYSEXT_APP_PKGS="cerastream gstreamer1.0-libuvcsrc srtla"
APPFS_APP_PKGS="ceralive-device"
# runtime-abi class: shared runtime libraries + first-party daemons installed into
# the rootfs, atomic with the RAUC slot (no sysext/appfs OTA split). libsrt is the
# forked SRT ABI; the nine ModemManager 1.24 closure packages and their
# Architecture: all support companion are the CeraLive cellular stack — they
# UPGRADE the Debian modem packages the runtime layer pulled via shared.list
# dependencies, in the same local dpkg transaction.
RUNTIME_APP_PKGS="libsrt1.5-ceralive \
modemmanager libmm-glib0 \
libmbim-glib4 libmbim-proxy libmbim-utils \
libqmi-glib5 libqmi-proxy libqmi-utils \
 libqrtr-glib0 ceralive-modem-support ceralive-apt-credentials"

# Binaries a sysext-class .deb MUST deliver — asserted after install so a broken or
# wrongly-pruned .deb fails loudly instead of shipping an app that cannot encode/bond
# (non-vacuity, mirroring mkosi/app/sysext-build.lib.sh's required-binary guard).
declare -A REQUIRED_BINARIES=(
  [cerastream]="/usr/bin/cerastream"
  [srtla]="/usr/bin/srtla_send"
)

stage_first_party_from_source_mount() {
  local src="${SRCDIR:-}"
  # CERALIVE_BOARD is the board MANIFEST STEM the orchestrator stages under
  # (lib/orchestrate.sh: STAGING_ROOT/<board>), forwarded via env_names +
  # mkosi.conf PassEnvironment=. NOT BOARD_ID (the Armbian BOARD= value): those
  # agree only on rock-5b-plus, so keying this path off BOARD_ID silently
  # installed zero first-party .debs on every other board.
  local board="${CERALIVE_BOARD:-}"
  if [[ -z "${src}" || -z "${board}" ]]; then
    log "source-mount staging unavailable (SRCDIR='${src}' CERALIVE_BOARD='${board}') — only ${FIRST_PARTY_DIR} can supply first-party .debs"
    return 0
  fi
  src="${src%/}/.staging/${board}/firstparty"

  if compgen -G "${FIRST_PARTY_DIR}/*.deb" >/dev/null 2>&1; then
    return 0
  fi
  if ! compgen -G "${src}/*.deb" >/dev/null 2>&1; then
    # Naming the probed path is the whole diagnosis when it is wrong. An empty
    # source is legitimate offline/dev, but it looks identical to a staging-key
    # mismatch, and the silent return is what hid exactly that for a release.
    log "no first-party .debs at the mkosi source staging path ${src}"
    return 0
  fi

  log "copying first-party .debs from mkosi source staging (${src})"
  mkdir -p "${FIRST_PARTY_DIR}"
  cp -a "${src}"/*.deb "${FIRST_PARTY_DIR}/"
}

# local_override_rows <record>: "name<TAB>version<TAB>arch" per row of fetch's
# first-party-local-override.json. Accepts only the exact one-line shape its writer
# (lib/fetch/firstparty.sh) produces, so a changed format fails the build here.
local_override_rows() {
  local text rest name version arch
  local obj='^\{"package": "([a-z0-9][a-z0-9+.-]+)", "version": "((([0-9]+):)?[0-9][A-Za-z0-9.+~-]*)", "arch": "([a-z0-9]+)", "sha256": "[0-9a-f]{64}", "filename": "[A-Za-z0-9.+~:_-]+\.deb"\}(, )?'
  local -A seen=()
  text="$(<"$1")" || return 1
  [[ "${text}" == '['*']' ]] || return 1
  rest="${text:1:${#text}-2}"
  while [[ -n "${rest}" ]]; do
    [[ "${rest}" =~ ${obj} ]] || return 1
    name="${BASH_REMATCH[1]}" version="${BASH_REMATCH[2]}" arch="${BASH_REMATCH[5]}"
    [[ -z "${seen[${name}]:-}" ]] || return 1
    seen[${name}]=1
    rest="${rest:${#BASH_REMATCH[0]}}"
    # A ", " separator needs another row after it; no separator ends the list.
    if [[ -n "${BASH_REMATCH[6]}" ]]; then [[ -n "${rest}" ]] || return 1; else [[ -z "${rest}" ]] || return 1; fi
    printf '%s\t%s\t%s\n' "${name}" "${version}" "${arch}"
  done
}

# ---------------------------------------------------------------------------
# pin_first_party_local_overrides: keep every first-party package this build took
# from a local override (fetch's first-party-local-override.json) at exactly that
# version. Such a package is not on apt.ceralive.tv; when apt.ceralive.tv later
# publishes a newer build under the same name, the origin pin (990) makes that the
# candidate, the device offers it as a package update and installing it replaces
# the reviewed local build. A name+version pin at 1001 keeps the installed version
# the candidate, so nothing is offered. Not a dpkg hold: CeraUI's package check
# refuses to run at all while a first-party package is held.
#
# The file sorts before ceralive-origin, because APT takes the first specific pin
# that matches a version. Each image carries its own pin for its own overrides,
# so an A/B update brings the new image's pin with its packages. A build without
# local overrides writes no file.
# ---------------------------------------------------------------------------
pin_first_party_local_overrides() {
  local record="${1:-${SRCDIR:+${SRCDIR%/}/.staging/${CERALIVE_BOARD:-}/first-party-local-override.json}}"
  local dir="${CERALIVE_APT_PREFERENCES_DIR:-/etc/apt/preferences.d}"
  local pin="${dir}/ceralive-local-override" rows name version arch got tmp
  rm -f -- "${pin}"
  if [[ -z "${record}" || ! -e "${record}" ]]; then
    log "no first-party local override record, so no local override pin"
    return 0
  fi
  rows="$(local_override_rows "${record}")" || die "unreadable first-party local override record: ${record}"
  if [[ -z "${rows}" ]]; then
    log "first-party local override record is empty, so no local override pin"
    return 0
  fi
  mkdir -p "${dir}"
  tmp="$(mktemp "${dir}/.ceralive-local-override.XXXXXXXX")"
  printf '# First-party packages this image installed from a reviewed local override,\n# pinned to that version (pin_first_party_local_overrides, app layer).\n' >"${tmp}"
  while IFS=$'\t' read -r name version arch; do
    got="$(dpkg-query -W -f='${Version}\t${Architecture}' "${name}" 2>/dev/null)" || got=""
    if [[ "${got}" != "${version}"$'\t'"${arch}" ]]; then
      rm -f -- "${tmp}"
      die "local override ${name}=${version} (${arch}) is not what is installed: ${got:-absent}"
    fi
    printf '\nPackage: %s\nPin: version %s\nPin-Priority: 1001\n' "${name}" "${version}" >>"${tmp}"
    log "local override pin: ${name}=${version} at 1001"
  done <<<"${rows}"
  chmod 0644 "${tmp}"
  mv -f -- "${tmp}" "${pin}"
}

# ---------------------------------------------------------------------------
# install_first_party_apps — classify + install every staged first-party .deb in
# ONE local transaction, then assert the sysext-class binaries actually landed.
# ---------------------------------------------------------------------------
install_first_party_apps() {
  local deb pkg
  local -a debs=() installed_pkgs=()
  shopt -s nullglob
  for deb in "${FIRST_PARTY_DIR}"/*.deb; do
    pkg="$(dpkg-deb -f "${deb}" Package)"
    [[ -n "${pkg}" ]] || die "cannot read Package: field from ${deb}"
    if [[ " ${pkg} " == *" rauc-hawkbit-updater "* ]]; then
      log "skip ${pkg} — OTA backport owned by the runtime layer (setup_hawkbit_updater)"
      continue
    fi
    if [[ " ${SYSEXT_APP_PKGS} " == *" ${pkg} "* ]]; then
      log "sysext-class : ${pkg}  ($(basename "${deb}"))"
    elif [[ " ${APPFS_APP_PKGS} " == *" ${pkg} "* ]]; then
      log "appfs-class  : ${pkg}  ($(basename "${deb}"))"
    elif [[ " ${RUNTIME_APP_PKGS} " == *" ${pkg} "* ]]; then
      log "runtime-abi  : ${pkg}  ($(basename "${deb}"))"
    else
      die "unclassified first-party package in staging: ${pkg} ($(basename "${deb}"))"
    fi
    debs+=("${deb}")
    installed_pkgs+=("${pkg}")
  done
  shopt -u nullglob

  if (( ${#debs[@]} == 0 )); then
    log "first-party staging held only non-app .debs — nothing to install in the app layer"
    return 0
  fi

  log "installing ${#debs[@]} first-party .deb(s) from local staging (no downloads; deps must be staged or in runtime)"
  if ! dpkg -i "${debs[@]}"; then
    log "dpkg left unresolved dependencies; resolving from already-available packages only"
    if [[ -n "${CERALIVE_DEBIAN_SNAPSHOT:-}" ]]; then
      (
        source "${SRCDIR:?}/runtime/build-apt-cache.sh"
        runtime_snapshot_apt_scope
        apt-get install -y --no-install-recommends --no-download -f
      )
    else
      apt-get install -y --no-install-recommends --no-download -f
    fi
  fi
  apt-get check

  if [[ " ${installed_pkgs[*]} " == *" libsrt1.5-ceralive "* ]]; then
    dpkg-query -W libsrt1.5-ceralive >/dev/null
    ! dpkg-query -W libsrt1.5-gnutls >/dev/null 2>&1
    ! dpkg-query -W libsrt1.5-openssl >/dev/null 2>&1
  fi

  assert_sysext_binaries "${installed_pkgs[@]}"

  if [[ " ${installed_pkgs[*]} " == *" ceralive-device "* ]]; then
    [[ -f /etc/systemd/system/ceralive.service ]] \
      || die "ceralive-device did not install ceralive.service"
    systemctl enable ceralive.service
    log "enabled ceralive.service for multi-user boot"
    keep_ceraui_workdir_helpers
  fi
}

# ---------------------------------------------------------------------------
# keep_ceraui_workdir_helpers [root] — keep an image-owned copy of the programs
# CeraUI runs from its working directory, outside that directory.
#
# CeraUI starts its captive-portal sign-in helper as
# `python3 -I <WorkingDirectory>/captive-portal-window.py`, and the .deb installs
# it under /opt/ceralive. On the device /data/ceralive is bind-mounted over
# /opt/ceralive (customize/postinst.d/persistence.sh), which hides the rootfs
# copy, so the backend cannot find it. The copy kept here sits outside the bind;
# ceralive-migrate-data links /data/ceralive/<name> to it on every boot, the way
# the seeded "public" link points at /var/www/ceralive, so the helper a box runs
# is the one its current slot shipped. A regular file there (an in-place CeraUI
# package upgrade writes one through the bind) stays only while it is not this
# copy's package: once the installed ceralive-device's md5sums name this copy's
# bytes, the link replaces it (keeping other bytes as .<name>.pre-link.<md5>),
# so an older image's file cannot outlive an OTA.
# This helper serves CeraUI's captive Wi-Fi sign-in window; the pipeline's own
# first-boot setup AP (ceralive-provision/ceralive-portal) does not use it.
# ---------------------------------------------------------------------------
CERAUI_WORKDIR_HELPERS=(captive-portal-window.py)
CERAUI_WORKDIR_HELPERS_DIR="/usr/libexec/ceralive/ceraui-workdir"
keep_ceraui_workdir_helpers() {
  local root="${1:-}" name src
  for name in "${CERAUI_WORKDIR_HELPERS[@]}"; do
    src="${root}/opt/ceralive/${name}"
    if [[ ! -f "${src}" ]]; then
      log "ceralive-device ships no /opt/ceralive/${name}; nothing to keep outside the /data bind"
      continue
    fi
    install -D -m 0755 "${src}" "${root}${CERAUI_WORKDIR_HELPERS_DIR}/${name}"
    log "kept /opt/ceralive/${name} at ${CERAUI_WORKDIR_HELPERS_DIR}/${name} (the /data bind hides the original)"
  done
}

# ---------------------------------------------------------------------------
# assert_sysext_binaries <installed_pkg...> — for each sysext-class package we
# installed, verify its REQUIRED_BINARIES are present + executable. Loud die on a
# gap so a broken .deb never ships as a silently-unstartable app.
# ---------------------------------------------------------------------------
assert_sysext_binaries() {
  local pkg bin bins missing=()
  for pkg in "$@"; do
    bins="${REQUIRED_BINARIES[$pkg]:-}"
    [[ -n "${bins}" ]] || continue
    # shellcheck disable=SC2086  # split the space-separated binary list on purpose
    for bin in ${bins}; do
      [[ -x "${bin}" ]] || missing+=("${pkg}:${bin}")
    done
  done
  if (( ${#missing[@]} > 0 )); then
    die "first-party install incomplete — missing/non-executable binaries: ${missing[*]}"
  fi
  log "sysext-class binaries verified present (cerastream / srtla_send where staged)"
}

clean_package_download_metadata() {
  log "removing build-time apt package indexes and downloaded archives"
  apt-get clean
  rm -rf /var/lib/apt/lists/* /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin
  mkdir -p /var/lib/apt/lists/partial /var/cache/apt/archives/partial
}

prune_final_image_payload() {
  local -a paths=(
    /usr/share/X11
    /usr/share/bash-completion
    /usr/share/gtk-3.0
    /usr/share/gtk-doc
    /usr/share/icons/Adwaita
    /usr/share/icons/hicolor
    /usr/share/info
    /usr/share/lintian
    /usr/share/man
    /usr/share/mime
    /usr/share/sounds
    /usr/share/zoneinfo/right
  )
  log "pruning desktop and documentation payload from final appliance image"
  rm -rf "${paths[@]}"
  prune_package_docs
}

# install_chroot_service_policy — self-contained twin of
# customize/postinst.d/services.sh::install_chroot_service_policy. This script
# deliberately does not source postinst-lib.sh (it is the app layer, which owns no
# runtime system configuration), so the four lines are repeated rather than
# imported. Keep the two in step: mode 0755 is the load-bearing part, because
# invoke-rc.d gates on `test -x` and reports a non-executable helper as MISSING.
#
# It is needed here and not merely inherited from the runtime layer because
# `dpkg -i` of the first-party .debs and the `apt-get install -f` fallback below
# both run outside any mkosi apt transaction, and mkosi unlinks its own copy.
install_chroot_service_policy() {
  local policy="${CERALIVE_POLICY_RCD:-/usr/sbin/policy-rc.d}"
  install -d -m 0755 "$(dirname "${policy}")"
  printf '#!/bin/sh\n# BUILD-TIME ONLY — deny every service start in the build chroot.\nexit 101\n' >"${policy}"
  chmod 0755 "${policy}"
  [[ -x "${policy}" ]] || die "could not install an EXECUTABLE ${policy} — invoke-rc.d would report it MISSING"
  log "build-time service-start policy installed at ${policy} (exit 101, mode 0755)"
}

# remove_chroot_service_policy — drop the build-time policy-rc.d.
#
# The base layer's skeleton tree installs /usr/sbin/policy-rc.d so invoke-rc.d
# declines every service start in the chroot instead of failing at it. That file
# must NOT ship: on the device it would block systemd's own sysv compatibility
# path and any later dpkg-driven service start. This is the last chroot script in
# the layer chain, so here is the correct place to undo it.
#
# Fail-loud rather than best-effort: a policy-rc.d that survives into the rootfs
# produces a device that installs packages and silently never starts them, which
# is far harder to diagnose than a failed build.
remove_chroot_service_policy() {
  local policy="${CERALIVE_POLICY_RCD:-/usr/sbin/policy-rc.d}"
  if [[ -e "${policy}" ]]; then
    log "removing the build-time service-start policy (${policy})"
    rm -f "${policy}" || true
  fi
  # The POSTCONDITION is the contract, not rm's exit status — hence the `|| true`
  # above. Whatever went wrong, the only thing that matters is whether the file is
  # still there when the rootfs is sealed.
  [[ ! -e "${policy}" ]] || die "build-time ${policy} survived into the final rootfs"
}

# prune_package_docs — the DEFERRED half of the appliance doc strip.
#
# The layers above are built WithDocs=yes so that man pages exist while packages
# are configured: several maintainer scripts register a man page as an
# update-alternatives slave during `configure`, and dpkg's --path-exclude had
# been deleting those files first (census rows 5 and 6 — 13 warnings and one hard
# error, and an alternatives database that disagreed with the filesystem).
#
# /usr/share/doc/*/copyright is KEPT, matching what mkosi's own WithDocs=no does
# via --path-include: the licence text is a distribution obligation, not payload.
# Directory SYMLINKS are kept too — Debian points /usr/share/doc/<pkg> at a
# sibling for many binary packages, and removing the link orphans that copyright.
# CERALIVE_DOC_ROOT exists so the shipped function itself can be driven against a
# synthetic tree by tests/mkosi-contract.bats; the build never sets it.
safe_prune_parent() {
  local glob="$1" remainder component parent=""
  [[ "${glob}" == /* ]] || { log "skipping unsafe non-absolute glob: ${glob}"; return 1; }
  remainder="${glob#/}"
  while [[ "${remainder}" == */* ]]; do
    component="${remainder%%/*}"
    remainder="${remainder#*/}"
    if [[ -z "${component}" || "${component}" == . || "${component}" == .. ||
          "${component}" == *'*'* || "${component}" == *'?'* ||
          "${component}" == *'['* || "${component}" == *']'* ]]; then
      log "skipping unsafe glob parent: ${glob}"
      return 1
    fi
    parent+="/${component}"
    if [[ -L "${parent}" ]]; then
      log "skipping glob with symlink parent ${parent}: ${glob}"
      return 1
    fi
  done
  [[ -n "${remainder}" && "${remainder}" != . && "${remainder}" != .. ]] \
    || { log "skipping unsafe glob: ${glob}"; return 1; }
}

prune_package_docs() {
  local docdir="${CERALIVE_DOC_ROOT:-/usr/share/doc}"
  if [[ -d "${docdir}" ]]; then
    log "pruning ${docdir} down to copyright files (deferred from the build layers)"
    find "${docdir}" -type f ! -name copyright -delete
    find "${docdir}" -mindepth 1 -type d -empty -delete
  fi

  # Todo 29 (update-system-overhaul): also apply the single prune-paths
  # manifest's globs. The runtime layer already wrote this file (BaseTrees=
  # %O/runtime inherits it), so no env var is needed here — it is read
  # directly, matching manifests/prune-paths.list's own documented single-
  # source design. Safe and redundant-by-design at this point (the runtime
  # layer already stripped these paths); the point is proving the SAME
  # manifest drives every consumer, not that this pass finds anything new.
  local prune_list="${CERALIVE_PRUNE_PATHS_LIST:-/usr/lib/ceralive/prune-paths.list}"
  if [[ -r "${prune_list}" ]]; then
    local line target
    local IFS=
    shopt -s nullglob
    while IFS= read -r line || [[ -n "${line}" ]]; do
      [[ -n "${line}" ]] || continue
      case "${line}" in \#*) continue ;; esac
      safe_prune_parent "${line}" || continue
      # shellcheck disable=SC2086 # glob expansion is required; IFS is empty, so paths are not word-split
      for target in ${line}; do
        rm -rf -- "${target}" 2>/dev/null || true
      done
    done <"${prune_list}"
    shopt -u nullglob
  fi
}

# ---------------------------------------------------------------------------
# keep_ceraui_build_stamps [root] — keep this slot's CeraUI build stamps outside
# the /data bind, with the package version they belong to.
#
# CeraUI reads `revision` (its commit) and `version` (its CalVer) relative to its
# WorkingDirectory, /opt/ceralive, to build the CeraUI row in Settings -> Versions.
# On the device /data/ceralive is bind-mounted over /opt/ceralive
# (customize/postinst.d/persistence.sh), so the .deb's copies are hidden and
# whatever /data holds is what CeraUI reads. ceralive-migrate-data links the two
# names to the copies kept here on every boot while the slot's installed
# ceralive-device is still the version recorded in package-version, so after an
# OTA the row names the new slot's CeraUI instead of the first image's.
# ---------------------------------------------------------------------------
CERAUI_BUILD_STAMPS=(revision version)
CERAUI_BUILD_STAMPS_DIR="/usr/libexec/ceralive/ceraui-stamps"
# NON-FATAL, like the boot side: a failure costs the Versions label, not the
# image. package-version is what lets the boot side link the copies, so the old
# one goes first, then every old copy, and the new one is written last
# (atomically) after this run's copies succeeded. Whatever a failure leaves has
# no package-version, so at boot that slot only removes stale links. If an old
# package-version cannot be removed, capture is skipped and it stays.
drop_ceraui_build_stamps() { # $1=dir $2=reason
  log "WARN: $2; the Versions row will show the dpkg version"
  rm -rf -- "$1" 2>/dev/null || log "WARN: could not remove $1; it has no package-version, so it is never linked"
}
keep_ceraui_build_stamps() {
  local root="${1:-}" name kept=0 package_version=""
  local dir="${root}${CERAUI_BUILD_STAMPS_DIR}"
  if ! rm -f -- "${dir}/package-version" 2>/dev/null; then
    log "WARN: could not clear an old ${CERAUI_BUILD_STAMPS_DIR}/package-version; not keeping CeraUI build stamps"
    return 0
  fi
  if ! rm -rf -- "${dir}" 2>/dev/null; then
    log "WARN: could not clear old copies in ${CERAUI_BUILD_STAMPS_DIR}; not keeping CeraUI build stamps"
    return 0
  fi
  for name in "${CERAUI_BUILD_STAMPS[@]}"; do
    [[ -f "${root}/opt/ceralive/${name}" && ! -L "${root}/opt/ceralive/${name}" ]] || continue
    if ! install -D -m 0644 "${root}/opt/ceralive/${name}" "${dir}/${name}"; then
      drop_ceraui_build_stamps "${dir}" "could not keep CeraUI's ${name} stamp"
      return 0
    fi
    kept=1
  done
  if (( ! kept )); then
    log "ceralive-device ships no build stamps in /opt/ceralive; nothing to keep outside the /data bind"
    return 0
  fi
  # shellcheck disable=SC2016 # dpkg-query's own field syntax
  package_version="$(dpkg-query --admindir="${root}/var/lib/dpkg" -W -f='${Version}' ceralive-device 2>/dev/null)" || package_version=""
  if [[ -z "${package_version}" ]] \
    || ! printf '%s\n' "${package_version}" >"${dir}/package-version.tmp" \
    || ! chmod 0644 "${dir}/package-version.tmp" \
    || ! mv -f -- "${dir}/package-version.tmp" "${dir}/package-version"; then
    drop_ceraui_build_stamps "${dir}" "could not record which ceralive-device the CeraUI build stamps belong to"
    return 0
  fi
  log "kept CeraUI build stamps for ceralive-device ${package_version} at ${CERAUI_BUILD_STAMPS_DIR}"
}

# ---------------------------------------------------------------------------
# gate_ceralive_watchdog_margin [root] — keep the runtime layer's
# ceralive.service.d/60-watchdog-margin.conf (WatchdogSec=90s) only when the
# installed ceralive-device unit arms a shorter service watchdog of its own.
#
# The drop-in widens an existing watchdog: the backend that ships a WatchdogSec
# unit pulses every WATCHDOG_USEC/2. A ceralive-device build whose unit has no
# WatchdogSec (2026.11.2 and older) has no pulse either, and the drop-in alone
# would turn a watchdog on that nothing feeds: systemd would abort and restart a
# healthy backend about every 90 s. A unit that already sets 90 s or more must
# not be shortened either.
#
# FAIL CLOSED: the drop-in stays only for the plain layout CeraUI ships. The
# unit must be printable ASCII with tabs and LF line ends only (no CR, NUL or
# BOM, which systemd also treats as line breaks or strips), with no indented
# line and no line ending in a backslash. It must then hold exactly one
# WatchdogSec assignment in the whole file, in a `[Service]` section, written
# `WatchdogSec=<N>`, `<N>s`, `<N>sec` or `<N>min` with N > 0 and below 90 s.
# Anything else (no unit at all included) removes the drop-in, which only gives
# up the wider margin. Only the packaged unit is read; no image drop-in other
# than this one sets WatchdogSec (tests/ceralive-watchdog-margin.bats).
# ---------------------------------------------------------------------------
CERALIVE_WATCHDOG_MARGIN_DROPIN="etc/systemd/system/ceralive.service.d/60-watchdog-margin.conf"
CERALIVE_WATCHDOG_MARGIN_SEC=90
packaged_watchdog_needs_margin() { # <unit file>
  local stray
  stray="$(LC_ALL=C tr -d '\t\n\040-\176' <"$1" | wc -c)" || return 1
  [[ "${stray}" -eq 0 ]] || return 1
  LC_ALL=C awk -v margin="${CERALIVE_WATCHDOG_MARGIN_SEC}" '
    /\\[[:space:]]*$/ { ambiguous = 1 }
    /^[[:space:]]+[^[:space:]]/ { ambiguous = 1 }
    /^\[/ && !/\]$/ { ambiguous = 1 }
    /^\[/ { in_service = ($0 == "[Service]"); next }
    /^WatchdogSec([[:space:]]|=|$)/ { n++; line = $0; if (!in_service) ambiguous = 1 }
    END {
      if (ambiguous || n != 1 || line !~ /^WatchdogSec=[1-9][0-9]*(s|sec|min)?$/) exit 1
      v = line; sub(/^WatchdogSec=/, "", v)
      secs = v + 0
      if (v ~ /min$/) secs *= 60
      exit (secs < margin) ? 0 : 1
    }
  ' "$1"
}
gate_ceralive_watchdog_margin() {
  local root="${1:-}"
  local unit="${root}/etc/systemd/system/ceralive.service"
  local dropin="${root}/${CERALIVE_WATCHDOG_MARGIN_DROPIN}"
  [[ -e "${dropin}" ]] || return 0
  if [[ -f "${unit}" ]] && packaged_watchdog_needs_margin "${unit}"; then
    log "kept ${CERALIVE_WATCHDOG_MARGIN_DROPIN}: the packaged ceralive.service arms a watchdog under ${CERALIVE_WATCHDOG_MARGIN_SEC} s"
    return 0
  fi
  rm -f "${dropin}"
  log "removed ${CERALIVE_WATCHDOG_MARGIN_DROPIN}: the installed ceralive.service has no plain watchdog under ${CERALIVE_WATCHDOG_MARGIN_SEC} s to widen"
}

main() {
  log "APPLICATION layer (Stage 3) — installing first-party CeraLive apps"
  install_chroot_service_policy
  stage_first_party_from_source_mount

  if compgen -G "${FIRST_PARTY_DIR}/*.deb" >/dev/null 2>&1; then
    install_first_party_apps
    keep_ceraui_build_stamps
    pin_first_party_local_overrides
  else
    log "no first-party .debs staged at ${FIRST_PARTY_DIR} (offline/dev build) — installing nothing"
  fi
  gate_ceralive_watchdog_margin

  # Staging hygiene: the staging tree must NEVER ship in the final image. Stage 3
  # consumes it (local .deb install above) BEFORE removing it.
  rm -rf "${FIRST_PARTY_DIR}"
  bash "${SRCDIR:?}/runtime/packages-lock-capture.sh" app ${SYSEXT_APP_PKGS} ${APPFS_APP_PKGS} ${RUNTIME_APP_PKGS}
  clean_package_download_metadata
  prune_final_image_payload
  remove_chroot_service_policy

  log "APPLICATION layer complete"
}

# mkosi executes this script directly (BASH_SOURCE == $0), so main runs in the
# build. Sourcing it (unit tests exercising install_first_party_apps against a
# scratch staging dir) leaves main unrun — the destructive prune/clean steps
# never touch the host.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
